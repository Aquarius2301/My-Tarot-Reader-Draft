{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MyTarotReader;Username=postgres;Password=YourStrongPassword!"
  },
  "Cors": {
    "FrontendUrl": "https://your-frontend-domain.example"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Google": {
    "ClientId": "YOUR_PRODUCTION_CLIENT_ID.apps.googleusercontent.com"
  },
  "AiTarot": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.0-flash",
    "MaxOutputTokens": 16384
  },
  "Jwt": {
    "SecretKey": "YOUR_VERY_LONG_SECRET_KEY_FOR_LOCAL_DEV_ENVIRONMENT",
    "Issuer": "https://localhost:7000",
    "Audience": "https://localhost:5173",
    "AccessTokenDurationMinutes": 480,
    "RefreshTokenDurationDays": 7
  },
  "TokenCleanup": {
    "IntervalMinutes": 60
  },
  "Wallet": {
    "InitialWhiteCoins": 5,
    "ExpireDays": 30
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your-smtp-username",
    "Password": "your-smtp-password",
    "FromAddress": "you@your-domain.com",
    "FromName": "My Tarot Reader",
    "EnableSsl": true
  }
}
